+def test_preserves_unrelated_top_level_keys():
+    doc = v1(custom={"owner": "peter"})
+    out = migrate(doc)
+    assert out["custom"] == {"owner": "peter"}
+
+
+def test_preserves_nested_and_unknown_keys_recursively():
+    doc = v1(
+        custom={"owner": "peter", "nested": {"deep": [1, 2, {"a": "b"}]}},
+        another_unknown_key="keep-me",
+    )
+    out = migrate(doc)
+    assert out["custom"] == {"owner": "peter", "nested": {"deep": [1, 2, {"a": "b"}]}}
+    assert out["another_unknown_key"] == "keep-me"
+
+
+def test_does_not_mutate_input():
+    doc = v1(custom={"owner": "peter"})
+    original = {k: v for k, v in doc.items()}
+    migrate(doc)
+    assert doc == original
+
+
