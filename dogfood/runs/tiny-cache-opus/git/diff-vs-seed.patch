+def test_refreshed_entry_stays_cached_for_a_new_ttl(clock):
+    # Regression: an expired entry was recomputed but kept its original timestamp,
+    # so every later call looked expired and recomputed again.
+    load_user, calls = make_loader(clock)
+    load_user(1)
+    clock.advance(30)
+    assert load_user(1) == {"id": 1, "n": 2}
+
+    clock.advance(1)
+    assert load_user(1) == {"id": 1, "n": 2}
+    clock.advance(28)  # 29s after the refresh: still within the new TTL
+    assert load_user(1) == {"id": 1, "n": 2}
+    assert calls == [1, 1]
+    assert load_user.cache_info() == CacheInfo(hits=2, misses=2, size=1)
+
+    clock.advance(1)  # 30s after the refresh: the new TTL has expired
+    assert load_user(1) == {"id": 1, "n": 3}
+    assert calls == [1, 1, 1]
+
+
 def test_cache_info_counts_hits_and_misses(clock):
     load_user, _ = make_loader(clock)
     load_user(1)
