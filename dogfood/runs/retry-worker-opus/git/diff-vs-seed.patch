@@ -42,6 +42,41 @@ def test_oversized_first_item():
     assert chunk([big, small], max_items=10, max_bytes=10) == [[big], [small]]
 
 
+def test_consecutive_oversized_items_each_emitted_alone():
+    big1, big2 = b(20, "X"), b(30, "Y")
+    assert chunk([big1, big2], max_items=10, max_bytes=10) == [[big1], [big2]]
+
+
+def test_oversized_item_after_full_batch_is_kept():
+    items = [b(1, "a"), b(1, "b")]
+    big, tail = b(50, "B"), b(1, "t")
+    assert chunk([*items, big, tail], max_items=2, max_bytes=10) == [items, [big], [tail]]
+
+
+def test_byte_limit_splits_each_near_limit_item():
+    items = [b(9, "a"), b(9, "b"), b(9, "c")]
+    assert chunk(items, max_items=10, max_bytes=10) == [[x] for x in items]
+
+
+def test_properties_hold_on_random_inputs():
+    import random
+
+    rng = random.Random(1234)
+    for _ in range(2000):
+        max_items = rng.randint(1, 5)
+        max_bytes = rng.randint(1, 20)
+        items = [b(rng.randint(0, 30), chr(97 + i % 26)) for i in range(rng.randint(0, 15))]
+        batches = chunk(items, max_items=max_items, max_bytes=max_bytes)
+        assert [x for batch in batches for x in batch] == items  # order, nothing lost
+        for batch in batches:
+            assert batch  # no empty batches
+            assert len(batch) <= max_items
+            if any(len(x) > max_bytes for x in batch):
+                assert len(batch) == 1  # oversized items travel alone
+            else:
+                assert sum(map(len, batch)) <= max_bytes
+
+
