diff --git a/tests/test_migrate.py b/tests/test_migrate.py
index b483b98..e41bf79 100644
--- a/tests/test_migrate.py
+++ b/tests/test_migrate.py
@@ -1,3 +1,5 @@
+import copy
+
 import pytest
 
 from cfgmigrate import CURRENT_VERSION, UnsupportedVersionError, migrate
@@ -38,3 +40,36 @@ def test_current_version_is_returned_as_is():
 def test_rejects_unsupported_versions(version):
     with pytest.raises(UnsupportedVersionError):
         migrate({"version": version, "timeout": 1})
+
+
+def test_issue_example_preserves_custom_section():
+    doc = {"version": 1, "timeout": 30, "plugins": ["foo"], "custom": {"owner": "peter"}}
+    assert migrate(doc) == {
+        "version": 2,
+        "request_timeout": 30,
+        "plugins": ["foo"],
+        "custom": {"owner": "peter"},
+    }
+
+
+def test_preserves_unknown_keys_recursively():
+    nested = {"a": {"b": [1, {"c": None}], "timeout": 5}, "flag": True}
+    out = migrate(v1(custom=nested, extra="x"))
+    assert out["custom"] == {"a": {"b": [1, {"c": None}], "timeout": 5}, "flag": True}
+    assert out["extra"] == "x"
+
+
+def test_does_not_mutate_input():
+    doc = v1(custom={"owner": "peter", "tags": ["a"]})
+    snapshot = copy.deepcopy(doc)
+    migrate(doc)
+    assert doc == snapshot
+
+
+def test_output_does_not_alias_input():
+    doc = v1(custom={"owner": "peter", "tags": ["a"]})
+    out = migrate(doc)
+    out["custom"]["tags"].append("b")
+    out["plugins"].append("bar")
+    assert doc["custom"]["tags"] == ["a"]
+    assert doc["plugins"] == ["foo"]
