{
  "schema_version": "1.0.0",
  "digest": {
    "algorithm": "sha-256",
    "value": { "encoding": "lowercase-hex", "hex_length": 64 }
  },
  "serialization": {
    "standard": "JCS (RFC 8785)",
    "rules": [
      "JCS orders object members and normalizes whitespace, number, and string encodings.",
      "JCS never sorts arrays; an ordered array keeps its given order because its order is semantic.",
      "A set array is validated by its own comparator BEFORE JCS serialization: it must already be sorted and duplicate-free, otherwise the input is rejected.",
      "Equality is canonical bytes: same ID + byte-equal = idempotent no-op; same ID + different bytes = identity collision.",
      "projections are excluded from the semantic digest.",
      "The whole snapshot is ordered by (record_type, id) before hashing."
    ]
  },
  "record_type_order": [
    "project",
    "repository",
    "workspace",
    "topic",
    "task",
    "declaration",
    "attempt",
    "attempt_end",
    "claim",
    "evidence",
    "reconciliation",
    "check_invocation",
    "check_result",
    "verdict",
    "settlement",
    "blocker",
    "blocker_resolution",
    "decision"
  ],
  "record_id_fields": {
    "project": "project_id",
    "repository": "repository_id",
    "workspace": "workspace_id",
    "topic": "topic_id",
    "task": "task_id",
    "declaration": "declaration_id",
    "attempt": "attempt_id",
    "attempt_end": "attempt_end_id",
    "claim": "claim_id",
    "evidence": "evidence_id",
    "reconciliation": "reconciliation_id",
    "check_invocation": "check_invocation_id",
    "check_result": "check_result_id",
    "verdict": "verdict_id",
    "settlement": "settlement_id",
    "blocker": "blocker_id",
    "blocker_resolution": "blocker_resolution_id",
    "decision": "decision_id"
  },
  "array_semantics": [
    { "path": "snapshot.repositories", "semantics": "set", "key": "repository_id" },
    { "path": "snapshot.workspaces", "semantics": "set", "key": "workspace_id" },
    { "path": "snapshot.topics", "semantics": "set", "key": "topic_id" },
    { "path": "snapshot.tasks", "semantics": "set", "key": "task_id" },
    { "path": "snapshot.declarations", "semantics": "set", "key": "declaration_id" },
    { "path": "snapshot.attempts", "semantics": "set", "key": "attempt_id" },
    { "path": "snapshot.attempt_ends", "semantics": "set", "key": "attempt_end_id" },
    { "path": "snapshot.claims", "semantics": "set", "key": "claim_id" },
    { "path": "snapshot.evidence", "semantics": "set", "key": "evidence_id" },
    { "path": "snapshot.reconciliations", "semantics": "set", "key": "reconciliation_id" },
    { "path": "snapshot.check_invocations", "semantics": "set", "key": "check_invocation_id" },
    { "path": "snapshot.check_results", "semantics": "set", "key": "check_result_id" },
    { "path": "snapshot.verdicts", "semantics": "set", "key": "verdict_id" },
    { "path": "snapshot.settlements", "semantics": "set", "key": "settlement_id" },
    { "path": "snapshot.blockers", "semantics": "set", "key": "blocker_id" },
    { "path": "snapshot.blocker_resolutions", "semantics": "set", "key": "blocker_resolution_id" },
    { "path": "snapshot.decisions", "semantics": "set", "key": "decision_id" },
    { "path": "project.repositories", "semantics": "set", "key": "repository_id" },
    { "path": "declaration.criteria", "semantics": "set", "key": "criterion_id" },
    { "path": "claim.evidence_ids", "semantics": "set", "comparator": "lexical-by-id" },
    { "path": "reconciliation.checks", "semantics": "ordered" },
    { "path": "reconciliation.limitations", "semantics": "ordered" },
    { "path": "check_result.diagnostics", "semantics": "ordered" },
    { "path": "check_result.reconciliation_ids", "semantics": "set", "comparator": "lexical-by-id" },
    { "path": "verdict.scope.evaluated_criteria", "semantics": "set", "comparator": "lexical-by-id" },
    { "path": "verdict.scope.unevaluated_criteria", "semantics": "set", "comparator": "lexical-by-id" },
    { "path": "verdict.basis.evidence_ids", "semantics": "set", "comparator": "lexical-by-id" },
    { "path": "verdict.basis.reconciliation_ids", "semantics": "set", "comparator": "lexical-by-id" },
    { "path": "verdict.findings", "semantics": "ordered" },
    { "path": "verdict.findings[].basis_refs", "semantics": "set", "comparator": "lexical-by-id" },
    { "path": "verdict.uncertainty", "semantics": "ordered" },
    { "path": "verdict.limitations", "semantics": "ordered" },
    { "path": "settlement.basis.blocker_ids", "semantics": "set", "comparator": "lexical-by-id" },
    { "path": "blocker_resolution.evidence_ids", "semantics": "set", "comparator": "lexical-by-id" },
    { "path": "decision.basis", "semantics": "ordered" }
  ]
}
